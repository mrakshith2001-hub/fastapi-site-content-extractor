# Copy to .env and adjust. Every value can also be set as an environment variable.

LOG_LEVEL=INFO
LOG_JSON=true

# SQLite for local runs; docker-compose uses PostgreSQL:
#   postgresql+asyncpg://extractor:extractor@postgres:5432/extractor
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# Set to false when the schema is managed with `alembic upgrade head`.
AUTO_CREATE_SCHEMA=true

# Any S3-compatible endpoint. Leave S3_ENDPOINT_URL empty for real AWS S3.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=ridgeline-site
S3_PREFIX=site/

# Change window. With STRICT_WINDOW=false the persisted inventory is authoritative,
# so changes are never lost if a scheduled run is skipped.
LOOKBACK_HOURS=24
STRICT_WINDOW=false

MIRROR_DIR=./data/mirror
RENDER_ORIGIN=http://site.local
RENDER_CONCURRENCY=3
RENDER_TIMEOUT_MS=20000
